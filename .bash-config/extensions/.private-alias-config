create-project-shortcuts() {
   for dir in "${PROJECT_ROOTS[@]}"; do
      if [ -d "$dir" ]; then

         alias $(basename $dir)="cd $dir"

         for path in ${dir}/*/; do
            if [ -d "$path" ]; then
               local dirname=$path
               local result="${dirname%"${dirname##*[!/]}"}"
               result="${result##*/}"
               result=${result:-/}
               
               alias $result="cd $path"
               
            fi
         done
      fi
   done
}
create-project-shortcuts


check-for-changes() {
   echo "Check for Untracked Changes"
   current_path=$PWD
   for dir in "${PROJECT_ROOTS[@]}"; do
      if [ -d "$dir" ]; then
         for path in ${dir}/*/; do
            if [ -d "$path" ]; then
               cd $path
               if [[ -d "$path/.git/" ]]; then
                  if [[ -n $(git status --porcelain -s) ]]; then
                     echo "‎ -> Untracked Changes in $(basename $path):"
                  fi      
               fi         
            fi
         done
      fi
   done
   cd $current_path
}


check-for-changes-verbose() {
   echo "Check for Untracked Changes"
   current_path=$PWD
   for dir in "${PROJECT_ROOTS[@]}"; do
      if [ -d "$dir" ]; then
         for path in ${dir}/*/; do
            if [ -d "$path" ]; then
               cd $path
               if [[ -d "$path/.git/" ]]; then
                  if [[ -n $(git status --porcelain -s) ]]; then
                     echo "‎ -> Untracked Changes in $(basename $path):"
                     git status --porcelain | sed 's/^/        /'
                     echo ""
                  fi      
               fi         
            fi
         done
      fi
   done
   cd $current_path
}


